# Portalis Control Plane Configuration
PORT=4310
DATABASE_URL=./portalis.db

# JWT & Session Secrets (Development Defaults - Change in Production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_example_32chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_example_32chars

# Gateway Inter-Service & Tunnel Grant Secrets
TUNNEL_GRANT_SECRET=dev_tunnel_grant_secret_example_32chars
INTERNAL_GATEWAY_SECRET=dev_internal_gateway_secret_example_32chars

# Gateway WebSocket Ingress URL
GATEWAY_WS_URL=ws://localhost:9000/v1/tunnel/ws
